#!/bin/sh
# Prepend a CPIO archive containing the CoreSight SSDT to the new initrd
# so the kernel's CONFIG_ACPI_TABLE_UPGRADE picks it up before acpi_init().
#
# Invoked by update-initramfs(8) after a new initrd has been written.
# Args: $1 = kernel version, $2 = path to the new initrd image.

set -eu

VERSION="${1:-}"
INITRD="${2:-}"

[ -n "$INITRD" ] && [ -f "$INITRD" ] || exit 0

AML=/usr/lib/sky1-coresight/coresight.aml
[ -f "$AML" ] || exit 0

# RadxaOS embloader actually reads from /boot/efi/RadxaOS/<kver>/initrd.img-<kver>.
# Update both copies so whichever the bootloader picks has the override.
EFI_INITRD="/boot/efi/RadxaOS/${VERSION}/initrd.img-${VERSION}"

prepend_override() {
    target="$1"
    [ -f "$target" ] || return 0
    if head -c 4096 "$target" 2>/dev/null | grep -q 'coresight\.aml'; then
        return 0
    fi
    tmp=$(mktemp -d)
    mkdir -p "$tmp/kernel/firmware/acpi"
    cp "$AML" "$tmp/kernel/firmware/acpi/coresight.aml"
    (cd "$tmp" && find kernel -print0 | LC_ALL=C sort -z | \
        cpio --null -H newc --create --quiet > override.cpio)
    cat "$tmp/override.cpio" "$target" > "$target.sky1cs.new"
    mv "$target.sky1cs.new" "$target"
    rm -rf "$tmp"
    echo "sky1-coresight-acpi: prepended SSDT override to $target"
}

prepend_override "$INITRD"
[ -n "$VERSION" ] && prepend_override "$EFI_INITRD"
