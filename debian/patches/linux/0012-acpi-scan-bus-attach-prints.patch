From: Radxa Sky1 <linux-sky1@radxa.com>
Date: Mon, 20 Apr 2026 00:00:00 +0000
Subject: [PATCH] acpi: scan: granular pr_emerg in bus_attach for SKY1 hang

Temporary instrumentation: log entry/exit of acpi_bus_attach() and a
step marker between every internal call (get_status, ec_opregions,
init_power, scan_attach_handler, device_attach, default_enumeration).
Used to localize which step never returns when an SSDT sink with a
low-MMIO _CRS is present.

Signed-off-by: Radxa Sky1 <linux-sky1@radxa.com>
---
--- a/src/drivers/acpi/scan.c
+++ b/src/drivers/acpi/scan.c
@@ -2186,6 +2186,15 @@
 	bool skip = !first_pass && device->flags.visited;
 	acpi_handle ejd;
 	int ret;
+	struct acpi_buffer __pbuf = { ACPI_ALLOCATE_BUFFER, NULL };
+	const char *__path = "?";
+
+	if (ACPI_SUCCESS(acpi_get_name(device->handle, ACPI_FULL_PATHNAME, &__pbuf)))
+		__path = __pbuf.pointer;
+	pr_emerg("sky1-cs: bus_attach ENTER %s skip=%d first=%d\n",
+		 __path, skip, first_pass ? 1 : 0);
+#define SKY1CS_STEP(s) pr_emerg("sky1-cs:   step %s %s\n", __path, s)
+	SKY1CS_STEP("a:before-ejd");

 	if (skip)
 		goto ok;
@@ -2193,33 +2202,46 @@
 	if (ACPI_SUCCESS(acpi_bus_get_ejd(device->handle, &ejd)))
 		register_dock_dependent_device(device, ejd);

+	SKY1CS_STEP("b:before-get_status");
 	acpi_bus_get_status(device);
+	SKY1CS_STEP("c:after-get_status");
 	/* Skip devices that are not ready for enumeration (e.g. not present) */
 	if (!acpi_dev_ready_for_enumeration(device)) {
 		device->flags.initialized = false;
 		acpi_device_clear_enumerated(device);
 		device->flags.power_manageable = 0;
+		pr_emerg("sky1-cs: bus_attach EXIT  %s (not ready)\n", __path);
+		kfree(__pbuf.pointer);
 		return 0;
 	}
 	if (device->handler)
 		goto ok;

+	SKY1CS_STEP("d:before-ec_opregions");
 	acpi_ec_register_opregions(device);
+	SKY1CS_STEP("e:after-ec_opregions");

 	if (!device->flags.initialized) {
 		device->flags.power_manageable =
 			device->power.states[ACPI_STATE_D0].flags.valid;
+		SKY1CS_STEP("f:before-init_power");
 		if (acpi_bus_init_power(device))
 			device->flags.power_manageable = 0;
+		SKY1CS_STEP("g:after-init_power");

 		device->flags.initialized = true;
 	} else if (device->flags.visited) {
 		goto ok;
 	}

+	SKY1CS_STEP("h:before-scan_attach_handler");
 	ret = acpi_scan_attach_handler(device);
-	if (ret < 0)
+	SKY1CS_STEP("i:after-scan_attach_handler");
+	if (ret < 0) {
+		pr_emerg("sky1-cs: bus_attach EXIT  %s (handler<0)\n", __path);
+		kfree(__pbuf.pointer);
 		return 0;
+	}

 	device->flags.match_driver = true;
 	if (ret > 0 && !device->flags.enumeration_by_parent) {
@@ -2227,21 +2249,33 @@
 		goto ok;
 	}

+	SKY1CS_STEP("j:before-device_attach");
 	ret = device_attach(&device->dev);
-	if (ret < 0)
+	SKY1CS_STEP("k:after-device_attach");
+	if (ret < 0) {
+		pr_emerg("sky1-cs: bus_attach EXIT  %s (dev_attach<0)\n", __path);
+		kfree(__pbuf.pointer);
 		return 0;
+	}

-	if (device->pnp.type.platform_id || device->flags.enumeration_by_parent)
+	if (device->pnp.type.platform_id || device->flags.enumeration_by_parent) {
+		SKY1CS_STEP("l:before-default_enumeration");
 		acpi_default_enumeration(device);
-	else
+		SKY1CS_STEP("m:after-default_enumeration");
+	} else {
 		acpi_device_set_enumerated(device);
+	}

 ok:
+	pr_emerg("sky1-cs: bus_attach RECUR %s\n", __path);
 	acpi_dev_for_each_child(device, acpi_bus_attach, first_pass);
+	pr_emerg("sky1-cs: bus_attach EXIT  %s (ok)\n", __path);

 	if (!skip && device->handler && device->handler->hotplug.notify_online)
 		device->handler->hotplug.notify_online(device);

+	kfree(__pbuf.pointer);
+#undef SKY1CS_STEP
 	return 0;
 }

