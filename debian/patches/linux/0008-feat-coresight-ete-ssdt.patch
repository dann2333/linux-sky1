+static int __init sky1_cs_ssdt_init(void)
+{
+	acpi_status status;
+
+	status = acpi_load_table((struct acpi_table_header *)sky1_cs_ssdt_aml,
+				 &sky1_cs_ssdt_index);
+	if (ACPI_FAILURE(status)) {
+		pr_err("sky1-coresight: acpi_load_table failed: 0x%x\n",
+		       status);
+		return -ENODEV;
+	}
+
+	acpi_bus_scan(ACPI_ROOT_OBJECT);
+	pr_info("sky1-coresight: SSDT installed (index %u)\n",
+		sky1_cs_ssdt_index);
+	return 0;
+}
+device_initcall(sky1_cs_ssdt_init);
