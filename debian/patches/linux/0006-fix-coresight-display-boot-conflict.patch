From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dann2333 <dann2333@users.noreply.github.com>
Date: Tue, 08 Apr 2026 00:00:00 +0000
Subject: [PATCH] fix: enable DP runtime PM to prevent boot conflict with
 CoreSight

On CIX Sky1 (Orion O6), enabling CoreSight ETE tracing
(CONFIG_CORESIGHT_SOURCE_ETM4X) selects PID_IN_CONTEXTIDR via Kconfig,
which adds an ISB (pipeline flush) to every context switch. This changes
boot timing enough to expose a pre-existing race in the DP display driver:
the driver accesses MMIO registers without holding a runtime PM reference
on the DPU power domain (SKY1_PD_DPU2), relying on implicit boot timing
for the power domain to remain active after linlondp_dev_create() calls
pm_runtime_put(). When boot timing shifts, the power domain may suspend
before the DP driver accesses hardware, causing a bus timeout (0x51).

Fix by enabling the DP driver's runtime PM infrastructure that was already
present but commented out:

1. Uncomment pm_runtime_enable/get_sync in trilin_dp_core_power_init() and
   pm_runtime_put_sync/disable in trilin_dp_core_power_deinit() to properly
   manage power state around DP hardware access.

2. Enable device_link from DP (consumer) to DPU (supplier) in
   trilin_dptx_cix_bind() so that DP's pm_runtime_get_sync() propagates to
   the DPU device, ensuring SKY1_PD_DPU2 is active before any DP register
   access. Note: the link direction is corrected from the original commented
   code (which had DPU as consumer) to properly reflect the dependency.

3. Add runtime PM callbacks and enable SET_RUNTIME_PM_OPS to complete the
   runtime PM integration.

No CoreSight functionality is affected - PID_IN_CONTEXTIDR, context ID
tracing, and all ETE/TRBE features remain fully enabled.

---
 src/drivers/gpu/drm/cix/dptx/trilin_dptx.c     |  8 ++++----
 src/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c | 16 +++++++++++++---
 2 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/src/drivers/gpu/drm/cix/dptx/trilin_dptx.c b/src/drivers/gpu/drm/cix/dptx/trilin_dptx.c
index 000000000001..000000000002 100644
--- a/src/drivers/gpu/drm/cix/dptx/trilin_dptx.c
+++ b/src/drivers/gpu/drm/cix/dptx/trilin_dptx.c
@@ -1949,9 +1949,9 @@
 {
 	DP_DEBUG("enter");
 
-	//power on DP_CORE_PM
-	//pm_runtime_enable(dp->dev);
-	//pm_runtime_get_sync(dp->dev);
+	/* power on DP_CORE_PM */
+	pm_runtime_enable(dp->dev);
+	pm_runtime_get_sync(dp->dev);
 
 	if (!IS_ERR(dp->dpsub->apb_clk))
 		clk_prepare_enable(dp->dpsub->apb_clk);
@@ -1966,8 +1966,8 @@
 	if (!IS_ERR(dp->dpsub->apb_clk))
 		if (__clk_is_enabled(dp->dpsub->apb_clk))
 			clk_disable_unprepare(dp->dpsub->apb_clk);
-	//pm_runtime_put_sync(dp->dev);
-	//pm_runtime_disable(dp->dev);
+	pm_runtime_put_sync(dp->dev);
+	pm_runtime_disable(dp->dev);
 	return 0;
 }
 
diff --git a/src/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c b/src/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c
index 000000000003..000000000004 100644
--- a/src/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c
+++ b/src/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c
@@ -171,8 +171,8 @@
 	if (ret)
 		return ret;
 
-	// dpsub->link = device_link_add(drm->dev, comp, DL_FLAG_STATELESS |
-	// 				DL_FLAG_PM_RUNTIME | DL_FLAG_RPM_ACTIVE);
+	dpsub->link = device_link_add(comp, drm->dev, DL_FLAG_STATELESS |
+					DL_FLAG_PM_RUNTIME | DL_FLAG_RPM_ACTIVE);
 
 	return 0;
 }
@@ -378,10 +378,20 @@
 	trilin_dp_pm_complete(dp);
 }
 
+static int trilin_dptx_runtime_suspend(struct device *dev)
+{
+	return 0;
+}
+
+static int trilin_dptx_runtime_resume(struct device *dev)
+{
+	return 0;
+}
+
 static const struct dev_pm_ops trilin_dptx_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(trilin_dptx_pm_suspend, trilin_dptx_pm_resume)
-	//SET_RUNTIME_PM_OPS(trilin_dptx_runtime_suspend,
-	//		trilin_dptx_runtime_resume, NULL)
+	SET_RUNTIME_PM_OPS(trilin_dptx_runtime_suspend,
+			trilin_dptx_runtime_resume, NULL)
 	.prepare = trilin_dptx_pm_prepare,
 	.complete = trilin_dptx_pm_complete,
 	.resume_early = trilin_dptx_pm_resume_early,
--
2.47.1
