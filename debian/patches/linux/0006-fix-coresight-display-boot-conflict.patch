From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dann2333 <dann2333@users.noreply.github.com>
Date: Tue, 08 Apr 2026 00:00:00 +0000
Subject: [PATCH] fix: resolve CoreSight and display driver boot conflicts

On CIX Sky1 (Orion O6), enabling CoreSight ETE tracing
(CONFIG_CORESIGHT_SOURCE_ETM4X) selects PID_IN_CONTEXTIDR via Kconfig,
which adds an ISB (pipeline flush) to every context switch in the vmlinux
binary. This changes boot timing enough to expose pre-existing races in
multiple display drivers (trilin DP bus timeout 0x51, orion VOP deadlock),
because these drivers rely on implicit boot timing for power sequencing.

Make PID_IN_CONTEXTIDR a runtime-toggled feature using an atomic
variable (contextidr_tracing_active). The write_sysreg+ISB in
contextidr_thread_switch() is skipped unless a CoreSight ETM trace
session is actively running. The ETM4x driver increments the counter
in etm4_enable() and decrements in etm4_disable(). This eliminates
the context-switch overhead during boot while preserving full
PID-in-CONTEXTIDR functionality during tracing. The atomic check is
guarded by IS_ENABLED(CONFIG_CORESIGHT_SOURCE_ETM4X) so that
PID_IN_CONTEXTIDR retains its original always-on behavior when
enabled without ETM4X (e.g. for external trace analyzers).

No CoreSight functionality is affected - PID_IN_CONTEXTIDR, context ID
tracing, and all ETE/TRBE features remain fully enabled during tracing.

---
 src/arch/arm64/include/asm/mmu_context.h                | 11 +++++++++++
 src/arch/arm64/kernel/process.c                         | 12 ++++++++++++
 src/drivers/hwtracing/coresight/coresight-etm4x-core.c |  8 +++++++-
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/arch/arm64/include/asm/mmu_context.h b/src/arch/arm64/include/asm/mmu_context.h
index 000000000001..000000000002 100644
--- a/src/arch/arm64/include/asm/mmu_context.h
+++ b/src/arch/arm64/include/asm/mmu_context.h
@@ -15,6 +15,7 @@
 #include <linux/sched/hotplug.h>
 #include <linux/mm_types.h>
 #include <linux/pgtable.h>
+#include <linux/atomic.h>
 
 #include <asm/cacheflush.h>
 #include <asm/cpufeature.h>
@@ -27,11 +28,19 @@
 
 extern bool rodata_full;
 
+#if IS_ENABLED(CONFIG_CORESIGHT_SOURCE_ETM4X)
+extern atomic_t contextidr_tracing_active;
+#endif
+
 static inline void contextidr_thread_switch(struct task_struct *next)
 {
 	if (!IS_ENABLED(CONFIG_PID_IN_CONTEXTIDR))
 		return;
 
+	if (IS_ENABLED(CONFIG_CORESIGHT_SOURCE_ETM4X) &&
+	    !atomic_read(&contextidr_tracing_active))
+		return;
+
 	write_sysreg(task_pid_nr(next), contextidr_el1);
 	isb();
 }
diff --git a/src/arch/arm64/kernel/process.c b/src/arch/arm64/kernel/process.c
index 000000000003..000000000004 100644
--- a/src/arch/arm64/kernel/process.c
+++ b/src/arch/arm64/kernel/process.c
@@ -72,6 +72,18 @@
 void (*pm_power_off)(void);
 EXPORT_SYMBOL_GPL(pm_power_off);
 
+#ifdef CONFIG_PID_IN_CONTEXTIDR
+/*
+ * Controls whether contextidr_thread_switch() writes PID to CONTEXTIDR_EL1.
+ * Defaults to 0 (disabled) so that the ISB on every context switch does not
+ * run during boot.  The ETM4x driver increments this when tracing starts
+ * and decrements when tracing stops, so the overhead only exists while
+ * CoreSight ETE tracing is actively in use.
+ */
+atomic_t contextidr_tracing_active = ATOMIC_INIT(0);
+EXPORT_SYMBOL_GPL(contextidr_tracing_active);
+#endif
+
 #ifdef CONFIG_HOTPLUG_CPU
 void __noreturn arch_cpu_idle_dead(void)
 {
diff --git a/src/drivers/hwtracing/coresight/coresight-etm4x-core.c b/src/drivers/hwtracing/coresight/coresight-etm4x-core.c
index 000000000005..000000000006 100644
--- a/src/drivers/hwtracing/coresight/coresight-etm4x-core.c
+++ b/src/drivers/hwtracing/coresight/coresight-etm4x-core.c
@@ -38,6 +38,7 @@
 #include <asm/sysreg.h>
 #include <asm/local.h>
 #include <asm/virt.h>
+#include <asm/mmu_context.h>
 
 #include "coresight-etm4x.h"
 #include "coresight-etm-perf.h"
@@ -881,6 +882,8 @@
 	/* The tracer didn't start */
 	if (ret)
 		local_set(&drvdata->mode, CS_MODE_DISABLED);
+	else
+		atomic_inc(&contextidr_tracing_active);
 
 	return ret;
 }
@@ -1057,8 +1060,10 @@
 		break;
 	}
 
-	if (mode)
+	if (mode) {
 		local_set(&drvdata->mode, CS_MODE_DISABLED);
+		atomic_dec(&contextidr_tracing_active);
+	}
 }
 
 static const struct coresight_ops_source etm4_source_ops = {
--
2.47.1
