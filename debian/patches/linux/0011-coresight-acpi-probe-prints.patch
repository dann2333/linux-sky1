From: Radxa Sky1 <linux-sky1@radxa.com>
Date: Mon, 20 Apr 2026 00:00:00 +0000
Subject: [PATCH] coresight: pr_emerg around ACPI probe paths for SKY1 bring-up

Temporary instrumentation: log entry/exit of ETE/TMC/funnel platform
probes and acpi_coresight_get_cpu(), so we can see in dmesg exactly
which CoreSight ACPI device probe is reached after modprobe and which
(if any) never returns. CoreSight is =m, so this fires only after
userspace, not during the early boot stall.

Signed-off-by: Radxa Sky1 <linux-sky1@radxa.com>
---
--- a/src/drivers/hwtracing/coresight/coresight-platform.c
+++ b/src/drivers/hwtracing/coresight/coresight-platform.c
@@ -742,17 +742,28 @@ static int acpi_coresight_get_cpu(struct device *dev)
 {
 	int cpu;
 	acpi_handle cpu_handle;
+	char *path = "?";
+	struct acpi_buffer buf = { ACPI_ALLOCATE_BUFFER, NULL };
 	acpi_status status;
 	struct acpi_device *adev = ACPI_COMPANION(dev);

-	if (!adev)
+	if (!adev) {
+		pr_emerg("sky1-cs: acpi_coresight_get_cpu: no ACPI companion for %s\n", dev_name(dev));
 		return -ENODEV;
+	}
+	if (ACPI_SUCCESS(acpi_get_name(adev->handle, ACPI_FULL_PATHNAME, &buf)))
+		path = buf.pointer;
+	pr_emerg("sky1-cs: acpi_coresight_get_cpu: enter dev=%s path=%s\n", dev_name(dev), path);
 	status = acpi_get_parent(adev->handle, &cpu_handle);
-	if (ACPI_FAILURE(status))
+	if (ACPI_FAILURE(status)) {
+		pr_emerg("sky1-cs: acpi_coresight_get_cpu: acpi_get_parent failed status=%d\n", status);
+		kfree(buf.pointer);
 		return -ENODEV;
+	}

 	cpu = acpi_handle_to_logical_cpuid(cpu_handle);
+	pr_emerg("sky1-cs: acpi_coresight_get_cpu: dev=%s logical cpu=%d\n", dev_name(dev), cpu);
+	kfree(buf.pointer);
 	if (cpu >= nr_cpu_ids)
 		return -ENODEV;
 	return cpu;
--- a/src/drivers/hwtracing/coresight/coresight-etm4x-core.c
+++ b/src/drivers/hwtracing/coresight/coresight-etm4x-core.c
@@ -2195,6 +2195,8 @@ static int etm4_probe_platform_dev(struct platform_device *pdev)
 	struct etmv4_drvdata *drvdata;
 	int ret;

+	pr_emerg("sky1-cs: etm4_probe_platform_dev enter dev=%s\n", dev_name(&pdev->dev));
+
 	drvdata = devm_kzalloc(&pdev->dev, sizeof(*drvdata), GFP_KERNEL);
 	if (!drvdata)
 		return -ENOMEM;
@@ -2223,6 +2225,7 @@ static int etm4_probe_platform_dev(struct platform_device *pdev)
 	if (ret)
 		pm_runtime_disable(&pdev->dev);

+	pr_emerg("sky1-cs: etm4_probe_platform_dev exit dev=%s ret=%d\n", dev_name(&pdev->dev), ret);
 	return ret;
 }

--- a/src/drivers/hwtracing/coresight/coresight-tmc-core.c
+++ b/src/drivers/hwtracing/coresight/coresight-tmc-core.c
@@ -118,6 +118,8 @@ static int tmc_platform_probe(struct platform_device *pdev)
 	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	int ret;

+	pr_emerg("sky1-cs: tmc_platform_probe enter dev=%s\n", dev_name(&pdev->dev));
+
 	if (!res)
 		return -ENODEV;

@@ -130,6 +132,7 @@ static int tmc_platform_probe(struct platform_device *pdev)
 	if (ret)
 		pm_runtime_disable(&pdev->dev);

+	pr_emerg("sky1-cs: tmc_platform_probe exit dev=%s ret=%d\n", dev_name(&pdev->dev), ret);
 	return ret;
 }

--- a/src/drivers/hwtracing/coresight/coresight-funnel.c
+++ b/src/drivers/hwtracing/coresight/coresight-funnel.c
@@ -33,8 +33,12 @@
 static int dynamic_funnel_platform_probe(struct platform_device *pdev)
 {
 	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	int ret;

-	return res ? funnel_probe(&pdev->dev, res) : -ENODEV;
+	pr_emerg("sky1-cs: dynamic_funnel_platform_probe enter dev=%s\n", dev_name(&pdev->dev));
+	ret = res ? funnel_probe(&pdev->dev, res) : -ENODEV;
+	pr_emerg("sky1-cs: dynamic_funnel_platform_probe exit dev=%s ret=%d\n", dev_name(&pdev->dev), ret);
+	return ret;
 }

 static struct platform_driver dynamic_funnel_platform_driver = {
